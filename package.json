{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@8.15.9",
  "description": "Drag and Drop for Vue Composition API",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky install",
    "test": "pnpm -r test",
    "lint": "eslint packages --quiet --ext .js,.ts,.vue --fix --no-error-on-unmatched-pattern",
    "lint:vitepress-style": "stylelint \"packages/**/\\.vitepress/**/*.{less,css,vue}\" --fix --allow-empty-input",
    "lint:style": "stylelint \"packages/**/*.{less,css,vue}\" --fix --allow-empty-input",
    "stylelint": "run-p lint:vitepress-style lint:style",
    "prettier": "prettier --write \"packages/**/*.{js,ts,jsx,tsx,vue,json}\" --no-error-on-unmatched-pattern",
    "ci": "run-p test lint stylelint prettier",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint -e -V",
    "pack-version": "changeset version",
    "release": "esno ./scripts/release.ts && changeset tag",
    "publish-success": "echo \"publish success\""
  },
  "author": "hcg1023 <2293885211@qq.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/hcg1023/vue3-dnd"
  },
  "homepage": "https://hcg1023.github.io/vue3-dnd/",
  "bugs": "https://github.com/hcg1023/vue3-dnd/issues",
  "license": "MIT",
  "keywords": [
    "drag",
    "drop",
    "dnd",
    "vue",
    "vuejs",
    "vue3",
    "composition-api",
    "react-dnd",
    "draggable",
    "droppable",
    "drag-and-drop"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@changesets/pre": "^1.0.14",
    "@changesets/read": "^0.6.7",
    "@changesets/types": "^5.2.1",
    "@commitlint/cli": "^16.2.4",
    "@commitlint/config-conventional": "^16.2.4",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@testing-library/jest-dom": "^5.17.0",
    "@types/node": "^17.0.45",
    "@types/testing-library__jest-dom": "^5.14.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^2.3.4",
    "@vue/composition-api": "^1.7.2",
    "cross-env": "^7.0.3",
    "eslint": "^8.15.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-vue": "^8.7.1",
    "esno": "^0.17.0",
    "fast-glob": "^3.3.3",
    "husky": "^7.0.4",
    "jsdom": "^19.0.0",
    "lint-staged": "^12.5.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.31",
    "postcss-html": "^1.8.1",
    "postcss-less": "^6.0.0",
    "prettier": "^2.8.8",
    "shx": "^0.4.0",
    "standard-version": "^9.3.2",
    "stylelint": "^14.16.1",
    "stylelint-config-prettier": "^9.0.5",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard": "^25.0.0",
    "stylelint-less": "^1.0.8",
    "stylelint-order": "^5.0.0",
    "typescript": "^4.9.5",
    "vitest": "^0.34.6",
    "vue": "3",
    "@vue/runtime-core": "3",
    "@vue/runtime-dom": "3",
    "vue-eslint-parser": "^8.3.0",
    "vue2": "npm:vue@2"
  },
  "lint-staged": {
    "*.{js,js,ts,tsx}": [
      "eslint --fix",
      "prettier --write",
      "vitest related --run"
    ],
    "*.{less,css,vue}": [
      "stylelint --fix"
    ]
  }
}
